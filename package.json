{
  "name": "brickforge",
  "version": "0.3.0-beta.12",
  "productName": "Brickforge",
  "main": "desktop/main.mjs",
  "author": "josemmc1992",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist-server/http.mjs",
    "mcp": "node --env-file-if-exists=.env dist-server/stdio.mjs",
    "test": "node scripts/test-portable.mjs",
    "backup": "node --env-file-if-exists=.env dist-server/backup.mjs",
    "typecheck": "tsc --noEmit",
    "check:repository": "node scripts/check-repository.mjs",
    "desktop:icons": "node scripts/desktop-icons.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:dir": "npm run build && npm run desktop:icons && electron-builder --config electron-builder.json --win --x64 --dir --publish never",
    "desktop:build": "npm run build && npm run desktop:icons && electron-builder --config electron-builder.json --win nsis portable --x64 --publish never",
    "desktop:test": "node scripts/desktop-test.mjs",
    "test:viewer": "node scripts/viewer-performance.mjs",
    "catalog:generate": "node scripts/catalog.mjs generate",
    "catalog:check": "node scripts/catalog.mjs check",
    "test:catalog": "node scripts/catalog.mjs test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "description": "Design LEGO with AI: a beta desktop and web 3D editor with a generic MCP server and local storage.",
  "overrides": {
    "global-agent": "4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/josemmc1992/brickforge.git"
  },
  "homepage": "https://github.com/josemmc1992/brickforge",
  "bugs": {
    "url": "https://github.com/josemmc1992/brickforge/issues"
  },
  "keywords": [
    "lego",
    "ai",
    "mcp",
    "ldraw",
    "3d",
    "beta"
  ]
}
